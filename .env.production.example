# ==============================================================================
# IQRA VIRTUAL SCHOOL — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT:
# 1. Never commit the actual filled .env file to version control.
# 2. Preserve the existing APP_KEY from current deployment. Do NOT run key:generate.
# 3. Keep APP_DEBUG=false and ALLOW_OPENING_BALANCE_POSTING=false.
# 4. Use HTTPS for APP_URL and enforce SESSION_SECURE_COOKIE=true.
# ==============================================================================

APP_NAME="IQRA Virtual School - Billing Portal"
APP_ENV=production
# Preserve existing APP_KEY from the source environment without modification:
APP_KEY=
APP_DEBUG=false
APP_URL=https://billing.iqraschool.edu.sa
APP_TIMEZONE=Asia/Karachi
APP_LOCALE=en

# ------------------------------------------------------------------------------
# Database Configuration (Dedicated restricted user)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=iqra_billing
# Explicitly approved database name enforced by DatabaseSafetyGuard:
APPROVED_DATABASE_NAME=iqra_billing
DB_USERNAME=iqra_billing_user
DB_PASSWORD="CHANGE_TO_STRONG_DATABASE_PASSWORD"
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ------------------------------------------------------------------------------
# Session, Cache & Storage
# ------------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# Logging (Daily rotation, warning/error level for production)
# ------------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# ------------------------------------------------------------------------------
# Financial Safety Controls
# ------------------------------------------------------------------------------
# Opening balances are already posted. Re-posting is STRICTLY PROHIBITED in production:
ALLOW_OPENING_BALANCE_POSTING=false
ACTIVE_IMPORT_VERSION=v3_final_myskool_20261023
ACTIVE_IMPORT_BATCH_ID=BATCH-20261023-FINAL-MYSKOOL

# ------------------------------------------------------------------------------
# Outbound Notifications (Webhook/N8N)
# ------------------------------------------------------------------------------
N8N_INVOICE_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_CALLBACK_SECRET=
IQRA_NOTIFICATION_RATE_LIMIT=30
# Set to true if external messaging is temporarily disabled:
NOTIFICATIONS_DISABLED=false

# ------------------------------------------------------------------------------
# Mail Configuration (Optional / SMTP)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="billing@iqraschool.edu.sa"
MAIL_FROM_NAME="${APP_NAME}"
